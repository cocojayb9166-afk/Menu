-- inside your Menu script
if not _G.AimLockInstance then
    _G.AimLockInstance = {} -- store the aim lock data/functions
end

-- function to enable
function _G.AimLockInstance:Enable()
    self.Connection = game:GetService("RunService").RenderStepped:Connect(function()
        if _G.AimLockActive then
            -- your aim lock code here
        end
    end)
end

-- function to disable
function _G.AimLockInstance:Disable()
    if self.Connection then
        self.Connection:Disconnect()
        self.Connection = nil
    end
end
